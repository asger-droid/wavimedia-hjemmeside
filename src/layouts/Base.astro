---
import '@fontsource/newsreader/400.css';
import '@fontsource/newsreader/500.css';
import '@fontsource/newsreader/400-italic.css';
import '@fontsource/newsreader/500-italic.css';
import '@fontsource/schibsted-grotesk/400.css';
import '@fontsource/schibsted-grotesk/500.css';
import '@fontsource/schibsted-grotesk/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
// The fonts the first screen needs, fetched first so text doesn't jump when they arrive. Same files the @font-face rules use.
import fSans400 from '@fontsource/schibsted-grotesk/files/schibsted-grotesk-latin-400-normal.woff2?url';
import fSans500 from '@fontsource/schibsted-grotesk/files/schibsted-grotesk-latin-500-normal.woff2?url';
import fSerif500 from '@fontsource/newsreader/files/newsreader-latin-500-normal.woff2?url';
import fSerif400i from '@fontsource/newsreader/files/newsreader-latin-400-italic.woff2?url';
import { META_PIXEL_ID, REQUIRE_CONSENT } from '../data/tracking';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
// preload: an image the first screen shows (the homepage hero photo), fetched before the stylesheet and fonts are parsed.
interface Props { title: string; description?: string; image?: string; imageAlt?: string; preload?: { src: string; srcset?: string; sizes: string } }
const { preload, title, description = 'Wavi Media is a senior-led growth studio for consumer brands. We optimise the P&L, not the dashboard.', image = '/wavi-deling/og/default.jpg', imageAlt = 'Wavi: Marketing for brands that intend to last.' } = Astro.props;
const full = title.includes('Wavi') ? title : `${title} | Wavi Media`;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), Astro.site);
// Share image for LinkedIn, Facebook, X and Slack (files in public/wavi-deling/). Absolute URL on wavimedia.com, as the platforms require.
const ogImage = new URL(image, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {preload && <link rel="preload" as="image" href={preload.src} imagesrcset={preload.srcset} imagesizes={preload.sizes} fetchpriority="high" />}
    {[fSans400, fSans500, fSerif500, fSerif400i].map((f) => <link rel="preload" href={f} as="font" type="font/woff2" crossorigin />)}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/wavi-deling/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta property="og:site_name" content="Wavi Media" />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={full} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#141414" />
    <!-- Meta Pixel: PageView on every page. Lead and custom events are sent from the contact form and the free tools. -->
    <script is:inline define:vars={{ pixelId: META_PIXEL_ID, requireConsent: REQUIRE_CONSENT }}>
      !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
      if (requireConsent) fbq('consent', 'revoke');
      fbq('init', pixelId);
      fbq('track', 'PageView');
    </script>
  </head>
  <body>
    <noscript><img height="1" width="1" style="display:none" alt="" src={`https://www.facebook.com/tr?id=${META_PIXEL_ID}&ev=PageView&noscript=1`} /></noscript>
    <a href="#main" class="skip">Skip to content</a>
    <Nav />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>

<style is:global>
  .skip { position: absolute; left: -9999px; top: 8px; z-index: 100; padding: 10px 16px; border-radius: 999px; background: var(--paper); color: var(--ink); }
  .skip:focus { left: 8px; }
</style>
