---
import Graphic from './Graphic.astro';
import { tracks, servicesFor, serviceHref, trackHref } from '../data/services';
---
<section class="s-paper section" data-tabs>
  <div class="container">
    <div class="row-between">
      <div><p class="eyebrow">Capabilities</p><h2 class="h2">Three tracks. <em class="accent">One system.</em></h2></div>
      <p class="body" style="max-width:380px">Every engagement is senior-led and measured on profit, not activity.</p>
    </div>
    <div role="tablist" aria-label="Service tracks" class="tabs">
      {tracks.map((t, i) => (
        <button type="button" role="tab" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
          <span class="label">{t.num}</span><span class="tabs__name">{t.name}</span>
        </button>
      ))}
    </div>
    {tracks.map((t, i) => (
      <div role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} class="panel on-ink" hidden={i !== 0}>
        <div>
          <p class="label">Track {t.num}</p>
          <p class="panel__line">{t.line}</p>
          <p class="body">{t.intro}</p>
          <ul class="rows panel__list">
            {servicesFor(t.id).map((s) => <li><a href={serviceHref(s.slug)}><span>{s.name}</span><span class="label">{s.platforms}{' '}<span class="arrow">→</span></span></a></li>)}
          </ul>
          <a href={trackHref(t.id)} class="btn btn--light" style="margin-top:32px">Explore {t.name}{' '}<span class="arrow">→</span></a>
        </div>
        <Graphic kind={t.graphic} />
      </div>
    ))}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const select = (tab: HTMLButtonElement) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on)); t.tabIndex = on ? 0 : -1;
        root.querySelector<HTMLElement>('#' + t.getAttribute('aria-controls'))!.hidden = !on;
      });
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t));
      t.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
        next.focus(); select(next);
      });
    });
  });
</script>

<style>
  .tabs { display: flex; flex-wrap: wrap; gap: 0 48px; margin-top: 72px; border-bottom: 1px solid var(--line); }
  .tabs button { display: flex; align-items: baseline; gap: 14px; padding: 20px 0; margin-bottom: -1px; border: 0; border-bottom: 2px solid transparent; background: none; cursor: pointer; color: var(--slate); }
  .tabs__name { font-family: var(--serif); font-size: clamp(32px, 3.6vw, 52px); letter-spacing: -0.02em; line-height: 1; opacity: 0.6; }
  .tabs [aria-selected='true'] { color: var(--ink); border-bottom-color: var(--ink); }
  .tabs [aria-selected='true'] .tabs__name { opacity: 1; font-weight: 500; }
  .panel { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: 48px 64px; align-items: center; margin-top: 32px; padding: clamp(28px, 4vw, 56px); border-radius: 10px; background: var(--ink); color: var(--paper); }
  .panel[hidden] { display: none; }
  .panel__line { margin: 20px 0; font-family: var(--serif); font-size: clamp(32px, 3.2vw, 46px); line-height: 1.08; letter-spacing: -0.015em; }
  .panel__list { margin-top: 36px; }
  .panel__list a { display: flex; justify-content: space-between; gap: 16px; align-items: center; padding: 18px 0; text-decoration: none; font-size: 19px; font-weight: 500; }
  .panel__list a:hover > span:first-child { color: var(--coral); }
</style>
