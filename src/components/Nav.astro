---
import Wave from './Wave.astro';
import { tracks, servicesFor, serviceHref, trackHref } from '../data/services';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/work', label: 'Work' },
  { href: '/framework', label: 'Framework' },
  { href: '/tools/profit-check', label: 'Free tools', match: '/tools' },
  { href: '/studio', label: 'Studio' }
];
const isActive = (l: { href: string; match?: string }) => path.startsWith(l.match ?? l.href);
const inServices = path.startsWith('/services');
---
<header class="nav" data-nav>
  <div class="container nav__bar">
    <a href="/" class="nav__logo" aria-label="Wavi, home"><Wave /><span>Wavi</span></a>
    <nav class="nav__links" aria-label="Primary">
      <button type="button" class:list={['nav__svc', { on: inServices }]} aria-expanded="false" aria-controls="nav-mega" data-mega-toggle>
        Services <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
      </button>
      {links.map((l) => <a href={l.href} class:list={[{ on: isActive(l) }]} aria-current={isActive(l) ? 'page' : undefined}>{l.label}</a>)}
    </nav>
    <div class="nav__end">
      <a href="/contact" class="btn btn--light nav__cta">Book a growth session</a>
      <button type="button" class="nav__menu" aria-expanded="false" aria-controls="nav-mobile" aria-label="Menu" data-mobile-toggle>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </button>
    </div>
  </div>

  <div id="nav-mega" class="nav__panel" hidden>
    <div class="container mega">
      {tracks.map((t) => (
        <div>
          <a href={trackHref(t.id)} class="mega__track">
            <span class="label">{t.num}</span>
            <span class="mega__name">{t.name}</span>
            <span class="mega__line">{t.line}</span>
          </a>
          <ul>{servicesFor(t.id).map((s) => <li><a href={serviceHref(s.slug)}>{s.name}<span aria-hidden="true">→</span></a></li>)}</ul>
        </div>
      ))}
      <a href="/framework" class="mega__card">
        <span class="label">How it fits together</span>
        <span><span class="mega__cardtitle">The Structured Growth Framework</span><span class="mega__cardlink">Read it →</span></span>
      </a>
    </div>
  </div>

  <div id="nav-mobile" class="nav__panel" hidden>
    <nav class="container mobile" aria-label="Mobile">
      {tracks.map((t) => <a href={trackHref(t.id)}>{t.name}<span class="label">{t.num}</span></a>)}
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
      <a href="/contact" class="btn btn--light">Book a growth session</a>
    </nav>
  </div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  const pairs: [string, string][] = [['[data-mega-toggle]', 'nav-mega'], ['[data-mobile-toggle]', 'nav-mobile']];
  const closeAll = () => pairs.forEach(([b, id]) => { document.getElementById(id)!.hidden = true; nav.querySelector(b)!.setAttribute('aria-expanded', 'false'); });
  pairs.forEach(([b, id]) => {
    nav.querySelector(b)!.addEventListener('click', () => {
      const panel = document.getElementById(id)!;
      const open = panel.hidden;
      closeAll();
      panel.hidden = !open;
      nav.querySelector(b)!.setAttribute('aria-expanded', String(open));
    });
  });
  document.addEventListener('click', (e) => { if (!nav.contains(e.target as Node)) closeAll(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeAll(); });
</script>

<style>
  .nav { position: relative; z-index: 50; background: var(--ink); color: var(--paper); border-bottom: 1px solid rgba(250, 248, 244, 0.1); }
  .nav__bar { display: flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 88px; }
  .nav__logo { display: flex; align-items: center; gap: 12px; text-decoration: none; font-family: var(--serif); font-weight: 500; font-size: 27px; letter-spacing: -0.01em; }
  .nav__links { display: flex; align-items: center; gap: 36px; font-size: 15px; font-weight: 500; }
  .nav__links a, .nav__svc { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; color: rgba(250, 248, 244, 0.72); text-decoration: none; background: none; border: 0; padding: 0; cursor: pointer; font-weight: 500; }
  .nav__links a:hover, .nav__svc:hover, .nav__links .on { color: var(--paper); }
  .nav__links a.on { box-shadow: inset 0 -1px 0 var(--paper); }
  .nav__svc[aria-expanded='true'] svg { transform: rotate(180deg); }
  .nav__end { display: flex; align-items: center; gap: 12px; }
  .nav__cta { min-height: 44px; padding: 0 20px; font-size: 15px; }
  .nav__menu { display: none; align-items: center; justify-content: center; width: 48px; height: 48px; border-radius: 999px; border: 1px solid rgba(250, 248, 244, 0.3); background: none; color: var(--paper); cursor: pointer; }
  .nav__panel { position: absolute; left: 0; right: 0; top: 100%; background: var(--ink); border-bottom: 1px solid rgba(250, 248, 244, 0.1); }
  .mega { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 40px; padding-block: 48px 56px; }
  .mega a { color: var(--paper); text-decoration: none; }
  .mega a:hover { color: var(--coral); }
  .mega__track { display: block; padding-bottom: 16px; border-bottom: 1px solid rgba(250, 248, 244, 0.14); }
  .mega__name { display: block; margin-top: 8px; font-family: var(--serif); font-size: 30px; font-weight: 500; }
  .mega__line { display: block; margin-top: 6px; font-size: 14px; line-height: 1.45; color: rgba(250, 248, 244, 0.6); }
  .mega ul { list-style: none; margin: 12px 0 0; padding: 0; }
  .mega li a { display: flex; justify-content: space-between; padding: 10px 0; font-size: 15px; }
  .mega li span { color: var(--stone); }
  .mega .mega__card { display: flex; flex-direction: column; justify-content: space-between; min-height: 220px; padding: 28px; border-radius: 8px; background: var(--sand); color: var(--ink); }
  .mega__cardtitle { display: block; font-family: var(--serif); font-size: 28px; font-weight: 500; line-height: 1.1; }
  .mega__cardlink { display: block; margin-top: 12px; font-weight: 600; }
  .mobile { display: flex; flex-direction: column; padding-block: 16px 32px; }
  .mobile a:not(.btn) { display: flex; justify-content: space-between; align-items: center; min-height: 56px; border-bottom: 1px solid rgba(250, 248, 244, 0.12); font-family: var(--serif); font-size: 26px; color: var(--paper); text-decoration: none; }
  .mobile .btn { margin-top: 24px; }
  @media (max-width: 920px) {
    .nav__links, .nav__cta { display: none; }
    .nav__menu { display: inline-flex; }
  }
</style>
