---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="s-ink"><div class="container" style="padding-block:160px">
    <p class="eyebrow">404</p>
    <h1 class="display" style="font-size:clamp(56px,8vw,128px)">This page has <em class="accent">left the funnel.</em></h1>
    <div style="display:flex;flex-wrap:wrap;gap:12px;margin-top:48px"><a href="/" class="btn btn--light">Back to the homepage</a><a href="/work" class="btn btn--ghost">See the work</a></div>
  </div></section>
</Base>
