---
import Base from '../layouts/Base.astro';
import Wave from '../components/Wave.astro';
import { site, testimonials } from '../data/site';

// Asger's personal LinkedIn. Leave empty to hide the link; paste the profile URL to show it everywhere on this page.
const founderLinkedIn = '';
// Checked on uk.trustpilot.com/review/wavimedia.com on 2 November 2026. Update when the score or count changes.
const trustpilot = { score: '4.7', label: 'Excellent', reviews: 25, href: 'https://uk.trustpilot.com/review/wavimedia.com' };
const quote = testimonials.lulu;
---
<Base title="Request a growth session" description="Tell us where growth stalls. You talk to the founder, and get a clear read on where the profit is within one business day.">
  <section class="s-sand">
    <div class="container intro">
      <div class="intro__copy">
        <p class="eyebrow">Start a conversation</p>
        <h1 class="h1 intro__h1">Tell us where growth <em class="accent">stalls.</em></h1>
        <p class="lead" style="margin-top:28px">A few details is enough. You get a clear read on where the profit is. No pitch, no account manager in between.</p>
        <figure class="founder">
          <img src="/images/asger-founder.webp" width="1200" height="1500" alt="Asger Olsson, founder of Wavi Media" decoding="async" />
          <figcaption>
            <p class="serif founder__line">“You’ll talk to me, not an account manager.”</p>
            <p class="label" style="margin-top:12px">Asger Olsson · Founder</p>
            <p class="founder__links">
              {founderLinkedIn && <a href={founderLinkedIn} target="_blank" rel="noopener">LinkedIn <span aria-hidden="true">↗</span></a>}
              <a href={`mailto:${site.email}`}>{site.email}</a>
            </p>
          </figcaption>
        </figure>
      </div>

      <div class="intro__form">
        <form class="form" data-contact novalidate>
          <div class="hp" aria-hidden="true"><label>Leave this empty<input name="wv_hp" type="text" tabindex="-1" autocomplete="off" data-1p-ignore data-lpignore="true" data-form-type="other" /></label></div>
          <label>Full name *<input name="name" type="text" required autocomplete="name" /></label>
          <label>Work email *<input name="email" type="email" required autocomplete="email" /></label>
          <label>Website URL *<input name="website" type="text" inputmode="url" required placeholder="yourbrand.com" /></label>
          <label><span class="lbl">Phone <span class="opt">optional</span></span><input name="phone" type="tel" autocomplete="tel" /></label>
          <label>Where is the business based? *<select name="region" required><option value="">Choose</option><option>Denmark</option><option>Sweden</option><option>Norway</option><option>Rest of Europe</option><option>Outside Europe</option></select></label>
          <label><span class="lbl">Avg. monthly revenue <span class="opt">optional</span></span><select name="revenue"><option value="">Choose a range</option><option>Under €150k</option><option>€150k - €500k</option><option>€500k - €2M</option><option>€2M+</option></select></label>
          <fieldset class="full"><legend>Where do you need help?</legend>
            <div class="checks">{['Acquisition', 'Retention', 'Advisory', 'Not sure yet'].map((v) => <label class="check"><input type="checkbox" name="help" value={v} />{v}</label>)}</div>
          </fieldset>
          <label class="full">Where does growth stall?<textarea name="message" rows="5" placeholder="A sentence or two is plenty. What feels stuck, and what have you tried?"></textarea></label>
          <p class="full form__error" data-error hidden role="alert"></p>
          <div class="full form__foot">
            <button type="submit" class="btn btn--dark" data-submit>Request a growth session <span class="arrow" aria-hidden="true">→</span></button>
            <p class="form__note">I reply within one business day. Your details are only used to answer you. <a href="/privacy">Privacy</a></p>
          </div>
        </form>
        <div class="card card--ink on-ink sent" role="status" data-sent hidden>
          <Wave width={72} height={29} weight={10} />
          <h2 class="h2" style="margin-top:32px;font-size:48px;line-height:1.05">Thank you. I’ll be in touch within one business day.</h2>
          <p class="body" style="margin-top:20px">In the meantime, run the profit check. It makes the first conversation sharper.</p>
          <a href="/tools/profit-check" class="btn btn--light" style="margin-top:32px">Run the profit check <span class="arrow">→</span></a>
        </div>
      </div>
    </div>

    <div class="container">
      <ol class="next">
        <li><span class="label">01 · Today</span><p class="serif">You send the details.</p><p class="body">Two minutes. The more you share about where it stalls, the sharper the first read.</p></li>
        <li><span class="label">02 · Within one business day</span><p class="serif">I reply personally.</p><p class="body">Not an auto-responder, not a sales team. A reply from me, with a time to talk.</p></li>
        <li><span class="label">03 · The growth session</span><p class="serif">A clear read on where the profit is.</p><p class="body">Non-binding. You leave knowing what we would fix first, whether we work together or not.</p></li>
      </ol>
    </div>
  </section>

  <section class="s-paper section">
    <div class="container">
      <div class="row-between"><div><p class="eyebrow">The company you would keep</p><h2 class="h2">Brands that intend to <em class="accent">last.</em></h2></div>
        <a href={trustpilot.href} class="tp" target="_blank" rel="noopener" aria-label={`Rated ${trustpilot.score} out of 5 on Trustpilot, ${trustpilot.reviews} reviews`}>
          <span class="tp__stars" aria-hidden="true">{[0, 1, 2, 3, 4].map(() => <svg viewBox="0 0 24 24" width="18" height="18"><path d="M12 2.5l2.9 6.2 6.6.7-5 4.5 1.4 6.6L12 17.2l-5.9 3.3 1.4-6.6-5-4.5 6.6-.7z" fill="currentColor" /></svg>)}</span>
          <span><span class="num tp__score">{trustpilot.score}</span><span class="label"> / 5 · {trustpilot.label} on Trustpilot · {trustpilot.reviews} reviews <span aria-hidden="true">↗</span></span></span>
        </a>
      </div>
      <div class="logos">{site.logos.map((l) => <img src={l.src} width={l.w} height={l.h} alt={l.name} loading="lazy" decoding="async" />)}</div>
      <div class="proof">
        <figure class="proof__quote"><blockquote class="serif">“{quote.text}”</blockquote><figcaption class="label">{quote.name} · {quote.role}</figcaption></figure>
        <dl class="proof__stats">{site.stats.map((s) => <div><dt class="num">{s.value}</dt><dd class="label">{s.label}</dd></div>)}</dl>
      </div>
    </div>
  </section>

  <section class="s-sand section">
    <div class="container ask">
      <div>
        <p class="eyebrow">Questions first?</p>
        <h2 class="h2">Just ask me <em class="accent">directly.</em></h2>
        <p class="lead" style="margin-top:28px">Pricing, timing, whether we are the right fit. Those are better answered in a conversation than in a FAQ.</p>
      </div>
      <div class="ask__links">
        {founderLinkedIn && <a href={founderLinkedIn} class="btn btn--dark" target="_blank" rel="noopener">Message me on LinkedIn <span aria-hidden="true">↗</span></a>}
        <a href={`mailto:${site.email}`} class:list={['btn', founderLinkedIn ? 'btn--ghost' : 'btn--dark']}>{site.email}</a>
      </div>
    </div>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact]')!;
  const err = form.querySelector<HTMLElement>('[data-error]')!;
  const btn = form.querySelector<HTMLButtonElement>('[data-submit]')!;
  const label = btn.innerHTML;
  const fail = (msg: string) => { err.textContent = msg; err.hidden = false; };
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) { fail('Please fill in the fields marked with *.'); form.querySelector<HTMLElement>(':invalid')?.focus(); return; }
    err.hidden = true;
    const fd = new FormData(form);
    const body: Record<string, unknown> = Object.fromEntries(fd.entries());
    body.help = fd.getAll('help');
    btn.disabled = true; btn.textContent = 'Sending…';
    try {
      const res = await fetch('/api/contact', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
      if (!res.ok) throw new Error(String(res.status));
      form.hidden = true;
      const sent = document.querySelector<HTMLElement>('[data-sent]')!;
      sent.hidden = false; sent.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } catch {
      fail('Something went wrong on our side. Please email hello@wavimedia.com and I will reply within one business day.');
      btn.disabled = false; btn.innerHTML = label;
    }
  });
</script>

<style>
  .intro { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 56px clamp(48px, 6vw, 96px); align-items: start; padding-block: clamp(64px, 8vw, 112px) clamp(48px, 5vw, 72px); }
  .intro__h1 { font-size: clamp(48px, min(5.4vw, 11vh), 88px); }
  .founder { display: flex; gap: 20px; align-items: center; margin: 48px 0 0; padding-top: 28px; border-top: 1px solid var(--line); }
  .founder img { flex: none; width: 96px; height: 120px; object-fit: cover; border-radius: 6px; background: var(--ink); }
  .founder__line { margin: 0; font-size: clamp(22px, 1.8vw, 26px); line-height: 1.2; letter-spacing: -0.01em; }
  .founder__links { display: flex; flex-wrap: wrap; gap: 6px 20px; margin: 14px 0 0; font-weight: 600; font-size: 15px; }
  .founder__links a { text-decoration: none; border-bottom: 1px solid currentColor; padding-bottom: 2px; }
  .founder__links a:hover { color: var(--coral); }
  .form { position: relative; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; padding: clamp(28px, 3vw, 44px); border-radius: 8px; background: var(--paper); box-shadow: 0 1px 0 rgba(20, 20, 20, 0.04), 0 24px 60px -32px rgba(20, 20, 20, 0.28); }
  .form[hidden] { display: none; }
  .form > label, .form legend { display: flex; flex-direction: column; gap: 8px; font-family: var(--mono); font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--slate); }
  /* "optional" sits on the same line as the field name, so fields in a row stay aligned. */
  .lbl { display: block; }
  .opt { margin-left: 6px; letter-spacing: 0.06em; text-transform: none; color: var(--stone); }
  .form input:not([type=checkbox]), .form select, .form textarea { height: 50px; padding: 0 14px; border-radius: 6px; border: 1px solid rgba(20, 20, 20, 0.24); background: #fff; color: var(--ink); font-family: var(--sans); font-size: 16px; letter-spacing: 0; text-transform: none; transition: border-color .2s, box-shadow .2s; }
  .form input:not([type=checkbox]):focus, .form select:focus, .form textarea:focus { outline: none; border-color: var(--ink); box-shadow: 0 0 0 3px rgba(20, 20, 20, 0.08); }
  .form textarea { height: auto; padding: 14px; line-height: 1.5; resize: vertical; }
  .form textarea::placeholder, .form input::placeholder { color: #A8A29A; }
  .form button[disabled] { opacity: 0.6; cursor: wait; }
  .full { grid-column: 1 / -1; }
  fieldset { margin: 0; padding: 0; border: 0; }
  .form legend { margin-bottom: 12px; }
  .checks { display: flex; flex-wrap: wrap; gap: 10px; }
  .check { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; padding: 0 16px; border-radius: 999px; border: 1px solid rgba(20, 20, 20, 0.2); font-size: 15px; cursor: pointer; transition: border-color .2s, background .2s; }
  .check:has(input:checked) { border-color: var(--ink); background: var(--sand); }
  .check input { accent-color: var(--ink); width: 16px; height: 16px; }
  .form__error { margin: 0; color: #A8341A; font-weight: 600; }
  .form__foot { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px; margin-top: 4px; }
  .form__note { margin: 0; flex: 1 1 220px; font-size: 14px; line-height: 1.5; color: var(--slate); }
  .form__note a { color: inherit; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .sent { padding: clamp(32px, 4vw, 56px); }
  .sent[hidden] { display: none; }
  .next { list-style: none; margin: 0; padding: 0 0 clamp(72px, 8vw, 112px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 0 clamp(24px, 3vw, 48px); }
  .next li { padding-top: 24px; border-top: 1px solid rgba(20, 20, 20, 0.22); }
  .next .serif { margin: 16px 0 0; font-size: clamp(24px, 2vw, 30px); line-height: 1.15; letter-spacing: -0.01em; }
  .next .body { margin-top: 10px; }
  .tp { display: inline-flex; align-items: center; gap: 16px; padding: 14px 22px; border-radius: 999px; border: 1px solid var(--line); text-decoration: none; transition: border-color .2s; }
  .tp:hover { border-color: var(--ink); }
  .tp__stars { display: inline-flex; flex: none; gap: 2px; color: var(--ink); }
  .tp__stars svg { flex: none; width: 18px; height: 18px; }
  .tp__score { font-size: 28px; }
  .logos { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 36px 64px; margin-top: 64px; padding: 48px 0; border-block: 1px solid var(--line); }
  .logos img { flex: none; }
  .proof { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 48px clamp(48px, 6vw, 96px); align-items: end; margin-top: 64px; }
  .proof__quote { margin: 0; }
  .proof__quote blockquote { margin: 0; font-size: clamp(30px, 3.2vw, 46px); line-height: 1.14; letter-spacing: -0.02em; }
  .proof__quote figcaption { margin-top: 24px; }
  .proof__stats { display: grid; grid-template-columns: 1fr 1fr; gap: 0; margin: 0; border-top: 1px solid var(--line); }
  .proof__stats > div { padding: 24px 16px 20px 0; border-bottom: 1px solid var(--line); }
  .proof__stats dt { font-size: clamp(40px, 4vw, 56px); }
  .proof__stats dd { margin: 10px 0 0; }
  .ask { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 40px 96px; align-items: end; }
  .ask__links { display: flex; flex-wrap: wrap; gap: 12px; justify-content: flex-end; }
  @media (max-width: 900px) {
    .intro, .proof, .ask { grid-template-columns: 1fr; }
    .ask__links { justify-content: flex-start; }
  }
</style>
