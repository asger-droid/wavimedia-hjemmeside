---
import Base from '../layouts/Base.astro';
import Cover from '../components/Cover.astro';
import { site } from '../data/site';
// Team as listed on the Framer site (/team). TODO: replace monogram tiles with portraits from the Cyprus shoot.
const tones = ['ink', 'slate', 'paper', 'sand'] as const;
const team = [
  ['Asger Olsson', 'CEO & Founder'],
  ['Emil Tuxen', 'Marketing Consultant'],
  ['Aske Munk', 'Marketing Consultant'],
  ['Lucas Tran', 'Shopify Developer'],
  ['Nathalie Berggreen', 'SOME Manager'],
  ['Julian', 'Consultant'],
  ['Anton', 'Videographer & Editor'],
  ['Theodor', 'Editor & SOME Manager'],
  ['Anna Marenza', 'Brand Designer'],
  ['Asbjørn Munk', 'Editor & Influencer Strategist']
].map(([name, role], i) => ({ name, role, letter: name[0], tone: tones[i % tones.length] }));
const audience = [
  ['Scaling consumer brands', '€2-50M revenue, ready to professionalise growth.'],
  ['Founder-led teams', 'Operators who want a partner, not a vendor.'],
  ['Profit-minded boards', 'People who read the P&L before the reach.']
];
---
<Base title="Studio: a small studio of senior people, on purpose">
  <section class="s-ink">
    <div class="container" style="padding-block:128px 112px">
      <p class="eyebrow">Studio · {site.studio}</p>
      <h1 class="h1" style="max-width:1100px">A small studio of senior people, <em class="accent">on purpose.</em></h1>
      <p class="lead" style="margin-top:40px">We are not built to be the biggest agency. We are built so the people who win the work are the people who do it.</p>
    </div>
  </section>

  <section class="s-paper section">
    <div class="container grid" style="--min:340px;--gap:64px 96px">
      <div><p class="eyebrow">Mission</p><p class="serif mv">Turn marketing spend into durable, profitable growth for ambitious consumer brands.</p></div>
      <div><p class="eyebrow">Vision</p><p class="serif mv">The studio Europe's best brands call when growth has to compound, not just spike.</p></div>
    </div>
  </section>

  <section class="s-paper section" style="border-top:1px solid var(--line)">
    <div class="container split" style="align-items:center">
      <div class="narrow" style="flex-basis:380px"><Cover brand="Asger Olsson" cat="Founder · portrait to come" motif="none" tone="ink" letter="A" ratio="4/5" /></div>
      <div class="wide">
        <p class="eyebrow">A note from the founder</p>
        <p class="serif" style="margin:0;font-size:clamp(28px,3vw,40px);line-height:1.2">“Most brands don't have a media problem. They have a control problem.”</p>
        <p class="serif" style="margin:32px 0 0;font-size:26px">Asger Olsson</p>
        <p class="label" style="margin-top:4px">Founder · Wavi Media</p>
      </div>
    </div>
  </section>

  <section class="s-sand section">
    <div class="container">
      <div class="row-between"><div><p class="eyebrow">The team</p><h2 class="h2">Senior hands.</h2></div><p class="body" style="max-width:420px">No account managers in between. You talk to the people doing the work.</p></div>
      <div class="grid" style="--min:200px;--gap:20px;margin-top:56px">
        {team.map((p) => <figure style="margin:0"><Cover brand="" cat="Portrait to come" motif="none" tone={p.tone} letter={p.letter} ratio="1/1" size="s" /><figcaption style="margin-top:16px"><span class="serif" style="display:block;font-size:24px">{p.name}</span><span class="label">{p.role}</span></figcaption></figure>)}
      </div>
    </div>
  </section>

  <section class="s-paper section">
    <div class="container">
      <div class="row-between"><div><p class="eyebrow">The company we keep</p><h2 class="h2">Brands that scale, <em class="accent">scale with us.</em></h2></div><p class="body" style="max-width:420px">A handful of the 276+ founders we’ve partnered with across the Nordics and beyond.</p></div>
      <ul class="logos">{site.logos.map((l) => <li><img src={l.src} width={l.w} height={l.h} alt={l.name} loading="lazy" decoding="async" /></li>)}</ul>
    </div>
  </section>

  <section class="s-ink section">
    <div class="container">
      <p class="eyebrow">Who we're for</p>
      <h2 class="h2" style="max-width:900px">We bridge media buying and <em class="accent">business building.</em></h2>
      <div class="grid" style="--min:260px;--gap:40px;margin-top:64px">
        {audience.map(([t, d]) => <div style="border-top:1px solid rgba(250,248,244,0.2);padding-top:28px"><h3 class="serif" style="margin:0;font-size:30px;font-weight:500">{t}</h3><p class="body" style="margin-top:12px">{d}</p></div>)}
      </div>
    </div>
  </section>

  <section class="s-sand section--tight">
    <div class="container">
      <p class="eyebrow">Tech stack &amp; partners</p>
      <ul class="pills">{site.partners.map((p) => <li>{p}</li>)}<li class="dark">Live client dashboards</li></ul>
      <a href="/tech-stack" class="link" style="display:inline-block;margin-top:32px">See the full tech stack <span class="arrow">→</span></a>
    </div>
  </section>
</Base>
<style>
  .mv { margin: 0; font-size: clamp(30px, 3.2vw, 44px); line-height: 1.12; letter-spacing: -0.015em; }
  .pills { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .pills li { padding: 12px 18px; border-radius: 999px; background: var(--paper); font-weight: 500; }
  .pills .dark { background: var(--ink); color: var(--paper); }
  .logos { list-style: none; margin: 64px 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr)); border: 1px solid var(--line); border-radius: 8px; overflow: hidden; }
  .logos li { display: flex; align-items: center; justify-content: center; min-height: 140px; margin: 0 -1px -1px 0; padding: 24px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .logos img { max-width: 100%; height: auto; }
</style>
