---
import Base from '../layouts/Base.astro';
import Wave from '../components/Wave.astro';
import ProfitInstrument from '../components/ProfitInstrument.astro';
import TrackTabs from '../components/TrackTabs.astro';
import Quotes from '../components/Quotes.astro';
import { site } from '../data/site';
import { featuredCases, caseBySlug } from '../data/cases';
import { coverPhoto, smallestOf } from '../data/case-gallery';
const framework = [
  ['The cost of a first order', 'Most brands scale spend before the maths holds up, and quietly pay more for every order than the business can carry. We get the unit economics right first, then pour fuel on it.'],
  ['What happens after the first sale', 'Acquisition cost never hits zero. What a customer is worth after the first order can always grow. We make the second and third purchase the default, not a happy accident.'],
  ['Too much resting on one thing', 'One channel, or one person who understands how it all fits, and growth is one change away from breaking. We spread the load into a system that holds.']
];
// The hero's rotating proof: cases with a real photo and a published result, strongest first.
const heroCases = ['lulu-copenhagen', 'herskind', 'mp-denmark', 'plusled', 'gobabygo', 'fashion-by-strand']
  .map((slug) => ({ c: caseBySlug(slug)!, img: coverPhoto(slug)! }))
  .filter((x) => x.c && x.img);
const HERO_SLIDE_MS = 6500;
const HERO_SIZES = '(min-width: 1100px) 44vw, calc(100vw - 40px)';
const heroFirst = heroCases[0].img;
const tools = [
  { href: '/tools/profit-check', path: '/profit-check', name: 'Profit check', text: 'What each order really leaves after ads.', cta: 'Run it' },
  { href: '/tools/store-scan', path: '/store-scan', name: 'Store scan', text: 'Tracking, pixels and consent, checked live.', cta: 'Scan' },
  { href: '/tools/growth-score', path: '/growth-score', name: 'Growth score', text: 'How structured is your growth, really?', cta: 'Score' },
  { href: '/contact', path: '/audit', name: 'Senior audit', text: 'A partner reviews your accounts, in writing.', cta: 'Request', dark: true }
];
---
<Base title="Wavi Media | Marketing for brands that intend to last" preload={{ src: heroFirst.src, srcset: heroFirst.srcset, sizes: HERO_SIZES }}>
  <section class="hero s-ink">
    <div class="container hero__inner">
      <div class="hero__copy">
        <h1 class="display hero__h1">Marketing for brands that <em class="accent">intend to last.</em></h1>
        <p class="lead hero__lead">Most agencies optimise the dashboard. We optimise the P&amp;L, and build the system that keeps it growing after we have stopped looking.</p>
        <div class="hero__ctas"><a href="/contact" class="btn btn--light">Book a growth session</a><a href="/work" class="hero__link">See the work</a></div>
        <p class="hero__partners"><span>Meta Business Partner</span><span>Google Partner</span><a href="/work/fashion-by-strand">Official Meta success story</a></p>
      </div>

      <div class="proof" data-proof style={`--slide:${HERO_SLIDE_MS}ms`} aria-roledescription="carousel" aria-label="Client results">
        <div class="proof__stage">
          {heroCases.map(({ c, img }, i) => (
            <a href={`/work/${c.slug}`} class:list={['proof__slide', { on: i === 0 }]} data-slide inert={i !== 0} aria-label={`${c.brand}: ${c.metric} ${c.label}. Read the case`}>
              <img
                src={i === 0 ? img.src : undefined}
                data-src={i === 0 ? undefined : img.src}
                srcset={i === 0 ? img.srcset : undefined}
                data-srcset={i === 0 ? undefined : img.srcset}
                sizes={HERO_SIZES}
                width={img.w} height={img.h} alt={img.alt}
                style={`object-position:${img.pos}`}
                fetchpriority={i === 0 ? 'high' : undefined}
                decoding={i === 0 ? 'sync' : 'async'}
              />
              <span class="proof__cap">
                <span class="proof__who"><span class="proof__brand">{c.brand}</span><span class="proof__sector">{c.sector}</span></span>
                <span class="proof__said">{c.statement}</span>
                <span class="proof__num"><span class:list={['num', { 'proof__metric--word': !/\d/.test(c.metric) }]}>{c.metric}</span><span class="proof__label">{c.label}</span></span>
              </span>
            </a>
          ))}
        </div>
        <div class="proof__dots" role="group" aria-label="Choose a case">
          {heroCases.map(({ c }, i) => <button type="button" class:list={['proof__dot', { on: i === 0 }]} data-dot={i} aria-label={`Show ${c.brand}`} aria-current={i === 0 ? 'true' : undefined}><i></i></button>)}
        </div>
      </div>

      <dl class="hero__stats">
        {site.stats.map((s) => <div><dt class="num">{s.value}</dt><dd>{s.label}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="marquee" aria-label="Brands we build with" data-marquee>
    <div class="marquee__track">
      {[0, 1].map((k) => site.logos.map((l) => <img data-src={l.src} width={l.w} height={l.h} alt={k === 0 ? l.name : ''} aria-hidden={k === 1 ? 'true' : undefined} decoding="async" />))}
    </div>
  </section>

  <ProfitInstrument />

  <section class="s-paper section">
    <div class="container">
      <p class="display manifesto">Most brands don't have a media problem.<br />They have a <em class="accent">control problem.</em></p>
      <div class="grid three" style="--min:280px;--gap:40px 64px">
        <p class="body">Performance agencies optimise clicks. Strategists draw maps. Neither owns the outcome.</p>
        <p class="body">We do both, and own the line from ad account to P&amp;L, so growth is a system you control, not a lever you rent.</p>
        <p class="body" style="color:var(--ink);font-weight:500">The people who win the work do the work. No juniors hidden behind a senior pitch.</p>
      </div>
    </div>
  </section>

  <section class="s-ink section">
    <div class="container">
      <div class="row-between">
        <div><p class="eyebrow">Statement of results</p><h2 class="h2">Proof, not <em class="accent">promises.</em></h2></div>
        <a href="/work" class="link">Read the full cases <span class="arrow">→</span></a>
      </div>
      <div class="ledger">
        <table>
          <thead><tr class="label"><th scope="col">No.</th><th scope="col">Client</th><th scope="col">Sector</th><th scope="col">Line item</th><th scope="col">Result</th></tr></thead>
          <tbody>
            {featuredCases.map((c, i) => (
              <tr data-preview={smallestOf(coverPhoto(c.slug))}>
                <td class="label">0{i + 1}</td>
                <td class="serif ledger__client"><a href={`/work/${c.slug}`} class="t-link">{c.brand}</a></td>
                <td>{c.sector}</td><td>{c.label}</td>
                <td class="num ledger__result">{c.metric === 'Meta' ? <a href={site.metaCase} class="btn btn--ghost ledger__pill">Meta success story ↗</a> : c.metric}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <img class="ledger__preview" alt="" aria-hidden="true" data-ledger-preview />
      </div>
    </div>
  </section>

  <TrackTabs />

  <section class="s-sand section">
    <div class="container split" style="align-items:flex-start">
      <div class="narrow sticky">
        <p class="eyebrow">The Structured Growth Framework</p>
        <h2 class="h2">Growth rarely stalls because of the ads.</h2>
        <p class="lead" style="margin-top:28px">It stalls because the system underneath was never built. We look in three places, always in this order.</p>
        <div class="rhythm" aria-hidden="true"><Wave width={56} height={22} weight={9} /><Wave width={56} height={22} weight={9} stroke="var(--stone)" /><Wave width={56} height={22} weight={9} stroke="var(--stone)" /></div>
        <a href="/framework" class="link">The full framework <span class="arrow">→</span></a>
      </div>
      <ol class="wide fw-list">
        {framework.map(([t, d], i) => <li class="card card--paper"><p class="fw-num">0{i + 1}</p><h3 class="h3">{t}</h3><p class="body" style="margin-top:14px">{d}</p></li>)}
      </ol>
    </div>
  </section>

  <Quotes />

  <section class="s-paper section">
    <div class="container">
      <div class="row-between">
        <div><p class="eyebrow">Free diagnostics</p><h2 class="h2">Know your numbers before the call.</h2></div>
        <p class="body" style="max-width:400px">Built on your real store and your own inputs. Nothing estimated, nothing invented.</p>
      </div>
      <div class="tools">
        {tools.map((t) => (
          <a href={t.href} class:list={['tools__item', { dark: t.dark }]}>
            <span class="label" style="text-transform:none;letter-spacing:0">{t.path}</span>
            <span><span class="h3" style="display:block">{t.name}</span><span class="body" style="display:block;margin-top:10px">{t.text}</span><span class="tools__cta">{t.cta}{' '}<span class="arrow">→</span></span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="s-ink section">
    <div class="container">
      <p class="eyebrow">Not the biggest agency. The best one for the brands we take on.</p>
      <h2 class="display" style="font-size:clamp(52px,7vw,120px)">Two ways in.</h2>
      <div class="grid" style="--min:340px;--gap:20px;margin-top:72px">
        <a href="/contact" class="card card--paper card--stack" style="--h:340px;color:var(--ink)">
          <span class="row-between label" style="align-items:center">Talk to a partner<Wave width={40} height={16} /></span>
          <span><span class="h2" style="display:block;font-size:clamp(40px,4vw,60px)">Book a growth session</span><span class="body" style="display:block;margin-top:16px">Non-binding. A reply within one business day.</span></span>
        </a>
        <a href="/tools/profit-check" class="card card--line card--stack on-ink" style="--h:340px">
          <span class="label">Do it yourself first</span>
          <span><span class="h2" style="display:block;font-size:clamp(40px,4vw,60px)">Run the profit check</span><span class="body" style="display:block;margin-top:16px">Your numbers, two minutes, nothing stored.</span></span>
        </a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Hero proof: one case at a time, crossfading. Pauses on hover, keyboard focus and hidden tabs; no autoplay for
  // people who prefer reduced motion. Only the first photo loads up front; the next one a few seconds in, the rest as they come up.
  const proof = document.querySelector<HTMLElement>('[data-proof]');
  if (proof) {
    const slides = [...proof.querySelectorAll<HTMLAnchorElement>('[data-slide]')];
    const dots = [...proof.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const ms = parseInt(getComputedStyle(proof).getPropertyValue('--slide')) || 6500;
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let at = 0, timer = 0, paused = false;
    const load = (el: HTMLAnchorElement) => { const img = el.querySelector('img')!; if (img.dataset.src) { if (img.dataset.srcset) img.srcset = img.dataset.srcset; img.src = img.dataset.src; delete img.dataset.src; } };
    const show = (n: number) => {
      at = (n + slides.length) % slides.length; load(slides[at]); load(slides[(at + 1) % slides.length]);
      slides.forEach((el, i) => { el.classList.toggle('on', i === at); el.inert = i !== at; });
      dots.forEach((d, i) => { d.classList.toggle('on', i === at); if (i === at) d.setAttribute('aria-current', 'true'); else d.removeAttribute('aria-current'); });
      // restart the progress line on the active dot
      const bar = dots[at].querySelector('i')!; bar.style.animation = 'none'; void bar.offsetWidth; bar.style.animation = '';
      schedule();
    };
    const schedule = () => { clearTimeout(timer); if (!still && !paused) timer = window.setTimeout(() => show(at + 1), ms); };
    const pause = (p: boolean) => { paused = p; proof.classList.toggle('paused', p); if (p) clearTimeout(timer); else schedule(); };
    dots.forEach((d, i) => d.addEventListener('click', () => show(i)));
    proof.addEventListener('mouseenter', () => pause(true));
    proof.addEventListener('mouseleave', () => pause(false));
    proof.addEventListener('focusin', () => pause(true));
    proof.addEventListener('focusout', () => pause(false));
    document.addEventListener('visibilitychange', () => pause(document.hidden));
    if (still) proof.classList.add('still');
    // The next case photo is fetched a few seconds in, so it doesn't compete with the first one; the rest as they come up.
    addEventListener('load', () => setTimeout(() => load(slides[1] ?? slides[0]), 3000), { once: true });
    schedule();
  }

  // Client logos load when the strip is close to the screen: at once on a laptop, on scroll on a phone.
  const marquee = document.querySelector<HTMLElement>('[data-marquee]');
  if (marquee) {
    const fill = () => marquee.querySelectorAll<HTMLImageElement>('img[data-src]').forEach((img) => { img.src = img.dataset.src!; img.removeAttribute('data-src'); });
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((e) => { if (e.some((x) => x.isIntersecting)) { fill(); io.disconnect(); } }, { rootMargin: '400px 0px' });
      io.observe(marquee);
    } else fill();
  }

  // A case photo follows the cursor while hovering a ledger row. Pointer devices only; the table stays as it is on touch.
  const img = document.querySelector<HTMLImageElement>('[data-ledger-preview]');
  if (img && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll<HTMLTableRowElement>('.ledger tr[data-preview]').forEach((row) => {
      row.addEventListener('mouseenter', () => { img.src = row.dataset.preview!; img.classList.add('on'); });
      row.addEventListener('mouseleave', () => img.classList.remove('on'));
      row.addEventListener('click', (e) => { if (!(e.target as HTMLElement).closest('a')) row.querySelector<HTMLAnchorElement>('a')?.click(); });
      row.addEventListener('mousemove', (e) => { img.style.transform = `translate(${e.clientX + 28}px, ${e.clientY - 120}px)${reduce ? '' : ' rotate(-2deg)'}`; });
    });
  }
</script>

<style>
  /* Hero: headline and case proof side by side. Not forced to fill the screen; the logo strip peeks in below. */
  .hero { position: relative; }
  .hero__inner { display: grid; grid-template-columns: minmax(0, 1.12fr) minmax(0, .88fr); grid-template-areas: "copy proof" "stats stats"; gap: 0 clamp(40px, 5vw, 80px); align-items: center; padding-block: clamp(36px, 6vh, 80px) 0; }
  .hero__copy { grid-area: copy; }
  /* Two lines on desktop. The longer line is about 9.6x the font size wide, so the size follows the column width (and the
     screen height, so short laptops keep the figures in view). */
  .hero__h1 { margin: 0; font-size: clamp(44px, min(calc((min(100vw, 1360px) - 80px) * 0.53 / 9.6), 9.4vh), 80px); line-height: 1.03; letter-spacing: -0.026em; text-wrap: balance; }
  .hero__lead { margin: clamp(22px, 3.4vh, 32px) 0 0; max-width: 29em; }
  .hero__ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 28px; margin-top: clamp(28px, 4.4vh, 42px); }
  .hero__link { font-weight: 600; text-decoration: none; padding: 6px 0 3px; border-bottom: 1px solid rgba(250, 248, 244, 0.5); transition: border-color .2s; }
  .hero__link:hover { border-color: var(--paper); }
  .hero__partners { display: flex; flex-wrap: wrap; gap: 8px 28px; margin: clamp(26px, 4.6vh, 48px) 0 0; font-size: 14px; color: var(--muted-inv); }
  .hero__partners a { color: var(--paper); text-decoration: none; border-bottom: 1px solid rgba(250, 248, 244, 0.35); }
  .hero__partners a:hover { border-color: var(--paper); }

  .proof { grid-area: proof; }
  .proof__stage { position: relative; height: clamp(380px, 57vh, 600px); border-radius: 12px; overflow: hidden; background: #1E1E1E; }
  .proof__slide { position: absolute; inset: 0; display: block; color: var(--paper); text-decoration: none; opacity: 0; transition: opacity 1.1s cubic-bezier(.4, 0, .2, 1); }
  .proof__slide.on { opacity: 1; z-index: 1; }
  .proof__slide img { width: 100%; height: 100%; object-fit: cover; transform: scale(1.06); transition: transform 7.5s cubic-bezier(.2, .6, .2, 1); }
  .proof__slide.on img { transform: scale(1); }
  .still .proof__slide, .still .proof__slide img { transition: none; transform: none; }
  .proof__cap { position: absolute; left: 16px; right: 16px; bottom: 16px; display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "who num" "said num"; gap: 6px 24px; align-items: end; padding: 20px 22px; border-radius: 8px; background: rgba(20, 20, 20, 0.84); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }
  .proof__who { grid-area: who; display: flex; flex-wrap: wrap; gap: 4px 12px; align-items: baseline; font-size: 14px; }
  .proof__brand { font-weight: 600; }
  .proof__sector { color: var(--muted-inv); }
  .proof__said { grid-area: said; font-family: var(--serif); font-size: clamp(18px, 1.3vw, 20px); line-height: 1.25; letter-spacing: -0.01em; }
  .proof__num { grid-area: num; display: flex; flex-direction: column; align-items: flex-end; text-align: right; }
  .proof__num .num { font-size: clamp(42px, 3.5vw, 54px); line-height: 0.95; }
  .proof__metric--word { font-style: italic; color: var(--coral); }
  .proof__label { margin-top: 8px; max-width: 12em; font-size: 13px; color: var(--muted-inv); }
  .proof__slide:hover .proof__brand, .proof__slide:focus-visible .proof__brand { text-decoration: underline; text-underline-offset: 3px; }
  .proof__slide:focus-visible { outline: 2px solid var(--paper); outline-offset: -4px; border-radius: 12px; }
  .proof__dots { display: flex; gap: 8px; margin-top: 14px; }
  .proof__dot { flex: 1; height: 24px; padding: 0; border: 0; background: none; cursor: pointer; }
  .proof__dot i { display: block; height: 2px; border-radius: 1px; background: rgba(250, 248, 244, 0.18); background-image: linear-gradient(var(--paper), var(--paper)); background-repeat: no-repeat; background-size: 0% 100%; }
  .proof__dot:hover i { background-color: rgba(250, 248, 244, 0.35); }
  .proof__dot.on i { animation: fill var(--slide) linear forwards; }
  .paused .proof__dot.on i, .still .proof__dot.on i { animation-play-state: paused; }
  .still .proof__dot.on i { animation: none; background-size: 100% 100%; }
  @keyframes fill { to { background-size: 100% 100%; } }
  .proof__dot:focus-visible { outline: 2px solid var(--paper); outline-offset: 2px; border-radius: 2px; }

  .hero__stats { grid-area: stats; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin: clamp(26px, 4.2vh, 56px) 0 0; border-top: 1px solid var(--line-inv); }
  .hero__stats > div { display: flex; align-items: baseline; gap: 12px; padding: clamp(14px, 2.2vh, 22px) 20px clamp(18px, 2.8vh, 28px) 0; }
  .hero__stats dt { font-size: clamp(26px, 2.2vw, 32px); }
  .hero__stats dd { margin: 0; font-size: 14px; color: var(--muted-inv); }
  @media (max-width: 1099px) {
    .hero__inner { grid-template-columns: 1fr; grid-template-areas: "copy" "proof" "stats"; padding-top: 40px; }
    .hero__h1 { font-size: clamp(40px, 9.2vw, 72px); }
    .proof { margin-top: 40px; }
    .proof__stage { height: auto; aspect-ratio: 4 / 4.2; max-height: 560px; }
    .hero__stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .hero__stats > div { flex-direction: column; gap: 4px; padding: 18px 12px 18px 0; }
  }
  @media (max-width: 560px) {
    /* Button and link on separate lines on phones, whatever the font, so nothing jumps when the web font arrives. */
    .hero__ctas { flex-direction: column; align-items: flex-start; gap: 18px; }
    .proof__cap { left: 10px; right: 10px; bottom: 10px; padding: 16px; grid-template-columns: 1fr; grid-template-areas: "who" "said" "num"; }
    .proof__num { flex-direction: row; align-items: baseline; gap: 10px; text-align: left; margin-top: 6px; }
    .proof__num .num { font-size: 40px; }
    .proof__label { margin: 0; }
    .proof__stage { aspect-ratio: 4 / 5; }
  }
  .marquee { overflow: hidden; border-bottom: 1px solid var(--line); }
  .marquee__track { display: flex; align-items: center; gap: 88px; width: max-content; padding: 36px 44px; animation: marquee 80s linear infinite; }
  .marquee__track img { flex: none; }
  .marquee:hover .marquee__track { animation-play-state: paused; }
  @media (prefers-reduced-motion: reduce) { .marquee__track { animation: none; flex-wrap: wrap; width: auto; justify-content: center; gap: 40px 64px; } .marquee__track img[aria-hidden] { display: none; } }
  @keyframes marquee { to { transform: translateX(-50%); } }
  .manifesto { font-size: clamp(44px, 6.4vw, 104px); line-height: 0.98; letter-spacing: -0.035em; }
  .three { margin-top: 88px; padding-top: 40px; border-top: 1px solid var(--line); }
  .ledger { overflow-x: auto; margin-top: 72px; }
  .ledger table { width: 100%; min-width: 720px; border-collapse: collapse; }
  .ledger th { padding: 0 0 16px; font-weight: 400; text-align: left; }
  .ledger th:last-child, .ledger td:last-child { text-align: right; }
  .ledger td { padding: 28px 0; border-top: 1px solid rgba(250, 248, 244, 0.16); color: var(--muted-inv); }
  .ledger tr:last-child td { border-bottom: 1px solid rgba(250, 248, 244, 0.16); }
  .ledger__client { font-size: 30px; color: var(--paper) !important; }
  .ledger__client a { text-decoration: none; }
  .ledger__result { font-size: 56px; color: var(--paper) !important; }
  .ledger__preview { position: fixed; left: 0; top: 0; z-index: 30; width: 260px; height: 200px; object-fit: cover; border-radius: 8px; box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35); opacity: 0; pointer-events: none; transition: opacity .2s ease; }
  .ledger__preview.on { opacity: 1; }
  .ledger tr[data-preview] { cursor: pointer; }
  .ledger__pill { min-height: 44px; font-size: 15px; font-family: var(--sans); letter-spacing: 0; }
  .sticky { position: sticky; top: 24px; }
  .rhythm { display: flex; gap: 14px; margin: 40px 0; }
  .fw-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 16px; }
  .fw-num { margin: 0 0 28px; font-family: var(--serif); font-style: italic; font-size: 88px; line-height: 0.8; }
  .tools { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1px; margin-top: 64px; background: var(--line); border: 1px solid var(--line); border-radius: 8px; overflow: hidden; }
  .tools__item { display: flex; flex-direction: column; justify-content: space-between; gap: 40px; min-height: 300px; padding: 36px; background: var(--paper); text-decoration: none; }
  .tools__item:hover .h3 { color: var(--coral); }
  .tools__item.dark { background: var(--ink); color: var(--paper); }
  .tools__item.dark .body { color: var(--muted-inv); }
  .tools__item.dark .label { color: var(--stone); }
  .tools__cta { display: block; margin-top: 24px; font-weight: 600; }
  @media (max-width: 700px) { .sticky { position: static; } }
</style>
